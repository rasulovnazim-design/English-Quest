// Cloudflare Workers config: serves the built game (dist/) as static assets.
// Cloudflare runs `npm run build`, then `npx wrangler deploy` on every push to main.
{
  "name": "english-quest",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
