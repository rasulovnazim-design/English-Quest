// Cloudflare Worker: serves the built game (dist/) and, once set up, asks for a one-time key first.
// Cloudflare runs `npm run build`, then `npx wrangler deploy` on every push to main.
//
// To switch the key gate on:
//   1. Cloudflare → Storage & Databases → KV → Create namespace "english-quest-keys"; put its ID below
//      (uncomment "kv_namespaces").
//   2. Worker → Settings → Variables and Secrets → add a Secret ADMIN_PASSWORD.
// Until both exist, the game stays open to everyone.
{
  "name": "english-quest",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
  // "kv_namespaces": [{ "binding": "KEYS", "id": "PASTE-KV-NAMESPACE-ID-HERE" }]
}
