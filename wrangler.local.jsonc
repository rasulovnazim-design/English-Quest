// Local testing only (npx wrangler dev -c wrangler.local.jsonc). Uses a local, in-memory keys store.
{
  "name": "english-quest",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "kv_namespaces": [{ "binding": "KEYS", "id": "local-test" }],
  "vars": { "ADMIN_PASSWORD": "local-admin" }
}
