  "grammar": {
    "title": "Глагол to be: am, is, are",
    "titleEn": "To be: am, is, are",
    "explanation": [
      "По-русски мы говорим «Я Анна», «Она моя коллега» — без глагола. В английском так нельзя: в таких предложениях обязательно нужен глагол to be («быть»). У него три формы в настоящем времени: am, is, are.",
      "I → am. He, she, it → is. You, we, they → are.",
      "В разговоре формы почти всегда сокращают: I'm, you're, he's, she's, it's, we're, they're. Полная форма звучит официально или подчёркнуто.",
      "Представляются так: I'm Ivan или My name's Ivan (дословно «моё имя есть Иван»)."
    ],
    "table": [
      { "en": "I am → I'm", "ru": "я" },
      { "en": "you are → you're", "ru": "ты, вы" },
      { "en": "he is → he's", "ru": "он" },
      { "en": "she is → she's", "ru": "она" },
      { "en": "it is → it's", "ru": "это, он, она (о предмете)" },
      { "en": "we are → we're", "ru": "мы" },
      { "en": "they are → they're", "ru": "они" }
    ],
    "examples": [
      { "en": "I'm Anna.", "ru": "Я Анна." },
      { "en": "She's my colleague.", "ru": "Она моя коллега." },
      { "en": "We're friends.", "ru": "Мы друзья." },
      { "en": "How are you?", "ru": "Как дела? (дословно «Как вы есть?»)" }
    ]
  },
