      { "en": "you", "ru": "ты, вы" },
      { "en": "he", "ru": "он (о человеке)" },
      { "en": "she", "ru": "она (о человеке)" },
      { "en": "it", "ru": "он, она, оно (о предмете, животном)" },
      { "en": "we", "ru": "мы" },
      { "en": "they", "ru": "они" }
    ],
    "examples": [
