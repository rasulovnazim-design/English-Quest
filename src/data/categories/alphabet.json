  "mistakes": [
    {
      "title": "Названия букв A, E, I",
      "text": "Английские буквы называются не так, как похожие на них русские: A — «эй», E — «и», I — «ай». Когда диктуете имя или адрес по буквам, E и I путают чаще всего.",
      "wrong": "Anna — «А, Н, Н, А»",
      "right": "Anna — «эй, эн, эн, эй»"
    },
    {
      "title": "Звук th — не «с» и не «з»",
      "text": "Кончик языка кладут между зубами и выдыхают. Глухой th — в словах think, three, thank you, звонкий — в this, that, the. Если сказать «синк» вместо think, получится sink — раковина.",
      "wrong": "«сэнк ю», «зис»",
      "right": "thank you, this"
    },
    {
      "title": "W и V — разные звуки",
      "text": "Для w губы вытягивают трубочкой, как для короткого «у», и зубы губ не касаются: wine, water, what. V — как русское «в»: very. Wine — вино, а vine — виноградная лоза.",
      "wrong": "«вайн», «вотер»",
      "right": "wine /waɪn/, water /ˈwɔːtə/"
    },
    {
      "title": "Краткие и долгие гласные",
      "text": "Долгота гласного меняет смысл: ship — корабль, sheep — овца; sit — сидеть, seat — место. Долгий звук [iː] тяните, краткий [ɪ] произносите коротко и расслабленно.",
      "wrong": "sheep вместо ship",
      "right": "ship /ʃɪp/ — sheep /ʃiːp/"
    },
    {
      "title": "Не оглушайте согласные в конце слова",
      "text": "В русском «дуб» звучит как «дуп». В английском звонкий согласный в конце слова остаётся звонким, иначе меняется смысл: bed — кровать, bet — ставка; bag — сумка, back — спина.",
      "wrong": "bed как «бет»",
      "right": "bed /bed/ — с чётким d"
    },
    {
      "title": "H — «эйч», Z — «зед»",
      "text": "Букву H называют «эйч», а не «аш». Z в британском английском — «зед», в американском — «зи». R в британском варианте называется «а», без «р».",
      "wrong": "«аш», «зет»",
      "right": "H — «эйч», Z — «зед»"
    },
    {
      "title": "I — всегда с большой буквы",
      "text": "Местоимение I («я») пишется заглавной буквой в любом месте предложения.",
      "wrong": "Anna and i are friends.",
      "right": "Anna and I are friends."
    }
  ],
