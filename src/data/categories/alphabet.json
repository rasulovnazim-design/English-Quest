      { "en": "Where's Olga? She's at home.", "ru": "Где Ольга? Она дома." },
      { "en": "This is my phone. It's new.", "ru": "Это мой телефон. Он новый." },
      { "en": "Ivan and I are friends. We're from Kazan.", "ru": "Мы с Иваном друзья. Мы из Казани." }
    ]
  },
